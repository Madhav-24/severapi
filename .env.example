# Copy to .env on the Linux host and protect it: chmod 600 .env
API_KEY=
MODEL_PATH=/models/construction-safety.pt
MODEL_ID=construction-safety-model
MODEL_VERSION=unspecified
GPU0_UUID=GPU-REPLACE-WITH-HOST-GPU-0-UUID
INFERENCE_DEVICE=cuda:0
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640
INFERENCE_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=10485760
MAX_INFLIGHT_INFERENCES=1
CORS_ALLOWED_ORIGINS=
HOST_PORT=8000
# Prefer loopback and a VPN-restricted reverse proxy. Set the server's
# internal/VPN interface address only after firewall rules are in place.
INTERNAL_BIND_ADDRESS=127.0.0.1
